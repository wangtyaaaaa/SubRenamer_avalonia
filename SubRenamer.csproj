<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SubRenamer</RootNamespace>
    <AssemblyName>SubRenamer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Publish'">
    <!-- NativeAOT 核心开关（注释掉，用 Single File 模式） -->
    <!-- <PublishAot>true</PublishAot> -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  
    <!-- Single File 模式：将所有托管代码打包进一个 exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  
    <!-- 裁剪配置 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
  
    <!-- 体积优化：优先尺寸而非速度 -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateCompressedOutput>true</IlcGenerateCompressedOutput>
  
    <!-- 关闭调试信息 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
  
    <!-- 全球化裁剪 -->
    <InvariantGlobalization>true</InvariantGlobalization>
  
    <!-- 关闭诊断、异常辅助信息 -->
    <StackTraceSupport>false</StackTraceSupport>
    <IlcDisableExceptionMessages>true</IlcDisableExceptionMessages>
    <EventSourceSupport>false</EventSourceSupport>
    <ActivityIdentificationSupport>false</ActivityIdentificationSupport>
  
    <!-- 反射元数据最小化（配合 ReflectionSuppressions.xml） -->
    <IlcGenerateCompleteTypeMetadata>false</IlcGenerateCompleteTypeMetadata>
    <InlineMe>true</InlineMe>
    <IlcReflectionSuppressionsFile>$(MSBuildProjectDirectory)\ReflectionSuppressions.xml</IlcReflectionSuppressionsFile>
  
    <!-- Avalonia 专属瘦身 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AvaloniaTrimNativeAssets>true</AvaloniaTrimNativeAssets>
    <AvaloniaEnableHotReload>false</AvaloniaEnableHotReload>
  
    <!-- 输出到 publish\SubRenamer 子目录 -->
    <PublishDir>$(MSBuildProjectDirectory)\publish\SubRenamer\</PublishDir>
  
  </PropertyGroup>




  <!-- 保留 Avalonia 相关程序集不被裁剪 -->
  <ItemGroup Condition="'$(Configuration)' == 'PublishTrimmed' or '$(Configuration)' == 'Publish'">
    <TrimmerRootAssembly Include="Avalonia" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="Avalonia.Fonts.Inter" />
    <TrimmerRootAssembly Include="Avalonia.Desktop" />
  </ItemGroup>

  <!-- Publish 后：清理旧文件 + 删除冗余文件 + 打包 zip -->
  <Target Name="CleanAndZipPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Publish'">
    <PropertyGroup>
      <FinalZipPath>$(MSBuildProjectDirectory)\publish\SubRenamer.zip</FinalZipPath>
    </PropertyGroup>

    <!-- 清理旧的 zip 文件 -->
    <Delete Files="$(FinalZipPath)" />
    <Message Text="已清理旧的压缩包" Importance="high" />

    <!-- 打包为 zip -->
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(FinalZipPath)"
                  Overwrite="true" />

    <Message Text="发布完成！$(FinalZipPath)" Importance="high" />
  </Target>

</Project>