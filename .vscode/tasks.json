{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/SubRenamer.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/SubRenamer.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/SubRenamer.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean-aot-out",
      "detail": "清理AOT发布目录",
      "type": "shell",
      "command": "Remove-Item",
      "args": [
        "${workspaceFolder}/publish/aot",
        "-Recurse",
        "-Force",
        "-ErrorAction",
        "SilentlyContinue"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish-aot",
      "detail": "NativeAOT 最小体积发布（多文件稳定版）",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/SubRenamer.csproj",
        "-c",
        "Publish",
        "-r",
        "win-x64",
        "--self-contained",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-o",
        "${workspaceFolder}/publish/aot"
      ],
      "problemMatcher": "$msCompile",
      "group": "build",
      "dependsOn": [
        "clean-aot-out"
      ]
    }
  ]
}